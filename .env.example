# Copy to .env for local development. Never commit .env.
# Production configuration comes from the environment; production secrets come
# from a cloud secret manager.

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql://localhost:5432/support_agent

# --- Model provider -----------------------------------------------------
# Credentials resolve through Application Default Credentials, so there is no
# API key here.
SUPPORT_AGENT_MODEL=google-cloud:gemini-3.5-flash
# Use a project dedicated to this course, never a production one.
GOOGLE_CLOUD_PROJECT=build-ai-systems-dev
# "global" is the cheaper tier in prices/. A region such as europe-west1 keeps
# inference in the EU and costs the non-global rate. See ARCHITECTURE.md.
GOOGLE_CLOUD_LOCATION=global

# --- Worker -------------------------------------------------------------
# The model and Slack are chosen independently, because they are two separate
# external systems and you often have one without the other.
#
#   WORKER_MODEL_SOURCE=configured  real Gemini through Vertex AI (needs ADC)
#   WORKER_MODEL_SOURCE=fixture     a canned decision, ignores the question
#
#   WORKER_SLACK_SINK=slack         really post to Slack (needs SLACK_BOT_TOKEN)
#   WORKER_SLACK_SINK=record        write the reply to Postgres and send nothing
#
# Both default to the real thing so a misconfigured deployment fails loudly.
# For local work with Vertex but no Slack workspace, use configured + record.
WORKER_MODEL_SOURCE=configured
WORKER_SLACK_SINK=record
WORKER_FAKE_FIXTURE=documented
WORKER_EXPECTED_TASK_IDENTITY=local-development-task
WORKER_DEADLINE_SECONDS=55

# --- Webhook ------------------------------------------------------------
# A valid Slack signature does not prove the event came from the workspace and
# channel this deployment serves, so both allowlists are checked as well.
# Comma separated; version 1 holds exactly one of each.
SLACK_ALLOWED_TEAM_IDS=T00000000
SLACK_ALLOWED_CHANNEL_IDS=C00000000

# Where the queue delivers. With Cloud Tasks this is the private worker's
# Cloud Run URL, and it is also the OIDC audience.
WORKER_BASE_URL=http://127.0.0.1:8081

# --- Queue --------------------------------------------------------------
#   TASK_QUEUE_BACKEND=local        an in-process queue and a worker on localhost
#   TASK_QUEUE_BACKEND=cloud-tasks  the real queue, with an OIDC token per task
#
# WORKER_TASK_IDENTITY is the static header the local queue sends. Cloud Tasks
# sends an OIDC token instead, minted for TASK_OIDC_SERVICE_ACCOUNT, which is
# the webhook's own service account.
TASK_QUEUE_BACKEND=local
WORKER_TASK_IDENTITY=local-development-task
TASK_QUEUE_LOCATION=europe-west1
TASK_QUEUE_NAME=support-requests
TASK_OIDC_SERVICE_ACCOUNT=support-webhook@build-ai-systems-dev.iam.gserviceaccount.com

# --- Slack --------------------------------------------------------------
# The worker holds the bot token because only the worker posts a reply.
# The webhook holds the signing secret because only the webhook verifies one.
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SIGNING_SECRET=replace-me
