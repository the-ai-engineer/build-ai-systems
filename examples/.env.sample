# Copy this file to examples/.env and fill in local values.

# Required for OpenAI model calls.
OPENAI_API_KEY=

# Required for Google ADK model calls through Google Cloud Agent Platform.
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
SUPPORT_AGENT_MODEL=gemini-3.5-flash

# Local PostgreSQL database shared by the Lesson 05 RAG examples.
RAG_DATABASE_URL=postgresql://rag:rag@localhost:5433/rag_lesson
