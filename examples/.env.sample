# Copy this file to examples/.env and fill in local values.

# Required for OpenAI model calls.
OPENAI_API_KEY=

# Required for Google ADK model calls through Google Cloud Agent Platform.
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
SUPPORT_AGENT_MODEL=gemini-3.5-flash

# Optional override for the local PostgreSQL database used by Lessons 05 and 06.
# The examples default to postgresql:///rag_lesson, which uses your OS user and local socket.
# RAG_DATABASE_URL=postgresql://postgres:password@localhost:5432/rag_lesson
